        thr_basins = THR_BASINS,
        seuil      = lambda wc: int(wc.seuil),
    conda: ENVIRONMENTS["slam"]
    log: f"{OUT}/aggregated/{{sub}}/zoe/adapt/{{seuil}}/{{sub}}.{{side}}.hausdorff.log"
    script:
        "scripts/compute_hausdorff.py"


rule aggregate_results2:
    input:
        zoe_results_tsv = expand(
            f"{OUT}/aggregated/{{sub}}/zoe/adapt/{{seuil}}/{{sub}}.{{side}}.{SPHERETEMP}.zoe_dist.tsv",
