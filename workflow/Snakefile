import yaml
from pathlib import Path

# =============================================================================
# UTILITY FUNCTIONS
# =============================================================================

def generate_range(param):
    start = param["start"]
    stop = param["stop"]
    step = param["step"]

    if step <= 0:
        raise ValueError("step must be strictly positive")

    if stop < start:
        raise ValueError("stop must be >= start")

    n = round((stop - start) / step)

    if abs(start + n * step - stop) > 1e-9:
        raise ValueError("The range must be divisible by step")

    return [
        f"{start + i * step:.2f}"
        for i in range(n + 1)
    ]


def get_parameter_values(parameters):
    values = {}

    for name, param in parameters.items():
        if isinstance(param, dict) and {"start", "stop", "step"} <= param.keys():
            values[name] = generate_range(param)
        else:
            values[name] = param

    return values

def select_data(key, available):
    requested = SELECTION.get(key, "all")

    # Toutes les données
    if requested == "all":
        return available

    # Sélection des N premiers éléments
    if isinstance(requested, int):
        return available[:requested]

    return requested

def get_all_labeled_skeletons(wildcards):
    """Return all labeled skeletons for one acquisition and hemisphere."""

    if not STEPS.get("projected_labels", False):
        raise ValueError(
            "plot_ISBI requires projected_labels to be enabled."
        )

    return [
        target.replace(
            ".skeletons.gii",
            ".skeletons_labeled.gii",
        )
        for target in SKELETON_TARGETS
        if (
            f"/{wildcards.test}/{wildcards.sub}/" in target
            and target.endswith(f"/{wildcards.sub}.{wildcards.side}.skeletons.gii")
        )
    ]

