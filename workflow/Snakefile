# -----------------------------------------------------------------------------
# Paths of all skeleton methods
# -----------------------------------------------------------------------------

METHOD_PATHS = set()

for target in SKELETON_TARGETS:
    target_path = Path(target)

    for test in TESTS:
        for sub in SUBJECTS:
            subject_dir = Path(OUT) / test / sub

            try:
                relative_method_path = target_path.relative_to(subject_dir).parent
            except ValueError:
                continue

            METHOD_PATHS.add(relative_method_path.as_posix())

METHOD_PATHS = sorted(METHOD_PATHS)

print("Methods included in ISBI plots:", METHOD_PATHS)

# 7. Projected labels + Hausdorff
