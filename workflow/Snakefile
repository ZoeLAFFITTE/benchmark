    output:
        desc_txt=f"{OUT}/{{test}}/{{sub}}/able/{{sub}}.{SIDE}.inspect.txt",
        gyri_gii=f"{OUT}/{{test}}/{{sub}}/able/{{sub}}.{SIDE}.gyri.gii",
        sulci_gii=f"{OUT}/{{test}}/{{sub}}/able/{{sub}}.{SIDE}.sulci.gii",
        depth_gii=f"{OUT}/{{test}}/{{sub}}/able/{{sub}}.{SIDE}.depthmap.gii",
        basins_gii=f"{OUT}/{{test}}/{{sub}}/able/{{sub}}.{SIDE}.sulcal_basins.gii",
        endpoints_npy=f"{OUT}/{{test}}/{{sub}}/able/{{sub}}.{SIDE}.endpoints.npy"

    log: f"{OUT}/{{test}}/{{sub}}/able/{{sub}}.{SIDE}.inspect.log"

    conda: ENVIRONMENTS["slam"]

    script: "scripts/inspect_matlab.py"

