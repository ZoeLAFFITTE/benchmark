    # Labeled skeletons
    LABELED_TARGETS = [
        target.replace(
            ".skeletons.gii",
            ".skeletons_labeled.gii",
        )
        for target in SKELETON_TARGETS
    ]

    FINAL_TARGETS.extend(LABELED_TARGETS)

    # Hausdorff targets
    HAUSDORFF_TARGETS = []

    for target in SKELETON_TARGETS:

        for test in TESTS:
            for sub in SUBJECTS:

                prefix = f"{OUT}/{test}/{sub}/"

                if not target.startswith(prefix):
                    continue

                method_path = target[len(prefix):].rsplit("/", 1)[0]

                for side in SIDE:

                    HAUSDORFF_TARGETS.append(
                        f"{OUT}/aggregated/{sub}/{method_path}/"
                        f"{sub}.{side}.{SPHERETEMP}.hausdorff.tsv"
                    )

    FINAL_TARGETS.extend(sorted(set(HAUSDORFF_TARGETS)))

