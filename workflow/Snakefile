        f"{OUT}/{{test}}/{{sub}}/cachia/{{sub}}.{{side}}.cachia.benchmark.txt"
    
    message :
        "fundi extraction --> Cachia() (sub={wildcards.sub}, side={wildcards.side}, test={wildcards.test})"

    singularity:
        CONTAINERS["brainvisa"]

    shell:
        """
        mkdir -p {OUT}/{wildcards.test}/{wildcards.sub}/cachia/brainvisa

        BRAINVISA_USER_DIR={OUT}/{wildcards.test}/{wildcards.sub}/cachia/brainvisa \
        /casa/install/bin/bv_env \
            python -m brainvisa.axon.runprocess \
            --enabledb \
            surface_sulci_dpf \
            {input.white_gii} \
            {input.dpf_white_gii} \
            {output.skeletons} \
            -0.005 10 10 \
            2>&1 | tee {log}
        """


