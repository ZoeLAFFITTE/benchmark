def get_method_inputs(wc):
    """Retourne un dictionnaire des chemins d'entrée nommés pour la règle."""
    base_inputs = {
        "match_tsv": f"{OUT}/aggregated/{wc.sub}/{wc.sub}.{wc.side}.matching.tsv",
        "white_test": f"{DATA}/{RAW}/HCP_test/{wc.sub}/{NATIVE}/{wc.sub}.{wc.side}.{WHITE}.surf.gii",
        "white_retest": f"{DATA}/{RAW}/HCP_retest/{wc.sub}/{NATIVE}/{wc.sub}.{wc.side}.{WHITE}.surf.gii",
        "sphere_reg_test": f"{DATA}/{RAW}/HCP_test/{wc.sub}/{REG}/{wc.sub}.{wc.side}.{SPHEREREG}.surf.gii",
        "sphere_reg_retest": f"{DATA}/{RAW}/HCP_retest/{wc.sub}/{REG}/{wc.sub}.{wc.side}.{SPHEREREG}.surf.gii",
        "dpf_test": f"{OUT}/HCP_test/{wc.sub}/preproc/{wc.sub}.{wc.side}.{WHITE}.DPF_star.gii",
        "dpf_retest": f"{OUT}/HCP_retest/{wc.sub}/preproc/{wc.sub}.{wc.side}.{WHITE}.DPF_star.gii",
        "basins_test": f"{DATA_TEST}/HCP_test_{wc.sub}_{wc.side}_{BASIN}.gii",
        "basins_retest": f"{DATA_TEST}/HCP_retest_{wc.sub}_{wc.side}_{BASIN}.gii",
    }
    
    # Ajout dynamique des fichiers de squelettes labellisés selon la méthode / variante
    if wc.method == "zoe":
        base_inputs["sulci_test"] = f"{OUT}/HCP_test/{wc.sub}/zoe/{wc.sub}.{wc.side}.{WHITE}.sulci.labeled.gii"
        base_inputs["sulci_retest"] = f"{OUT}/HCP_retest/{wc.sub}/zoe/{wc.sub}.{wc.side}.{WHITE}.sulci.labeled.gii"
    elif wc.method == "mindboggle":
        base_inputs["sulci_test"] = f"{OUT}/HCP_test/{wc.sub}/mindboggle/{wc.sub}.{wc.side}.{WHITE}.fundi.labeled.gii"
        base_inputs["sulci_retest"] = f"{OUT}/HCP_retest/{wc.sub}/mindboggle/{wc.sub}.{wc.side}.{WHITE}.fundi.labeled.gii"
    elif wc.method == "trace":
        base_inputs["sulci_test"] = f"{OUT}/HCP_test/{wc.sub}/trace/{wc.sub}.{wc.side}.{WHITE}.scurve_bary_c.labeled.gii"
        base_inputs["sulci_retest"] = f"{OUT}/HCP_retest/{wc.sub}/trace/{wc.sub}.{wc.side}.{WHITE}.scurve_bary_c.labeled.gii"
    elif wc.method == "zoe_adapt_dist":
        base_inputs["sulci_test"] = f"{OUT}/HCP_test/{wc.sub}/zoe/adapt/dist/{wc.params_path}/{wc.sub}.{wc.side}.{WHITE}.sulci_labeled.gii"
        base_inputs["sulci_retest"] = f"{OUT}/HCP_retest/{wc.sub}/zoe/adapt/dist/{wc.params_path}/{wc.sub}.{wc.side}.{WHITE}.sulci_labeled.gii"
    elif wc.method == "zoe_adapt_len":
        base_inputs["sulci_test"] = f"{OUT}/HCP_test/{wc.sub}/zoe/adapt/len/{wc.params_path}/{wc.sub}.{wc.side}.{WHITE}.sulci_labeled.gii"
        base_inputs["sulci_retest"] = f"{OUT}/HCP_retest/{wc.sub}/zoe/adapt/len/{wc.params_path}/{wc.sub}.{wc.side}.{WHITE}.sulci_labeled.gii"
    elif wc.method == "zoe_adapt_both":
        base_inputs["sulci_test"] = f"{OUT}/HCP_test/{wc.sub}/zoe/adapt/both/{wc.params_path}/{wc.sub}.{wc.side}.{WHITE}.sulci_labeled.gii"
        base_inputs["sulci_retest"] = f"{OUT}/HCP_retest/{wc.sub}/zoe/adapt/both/{wc.params_path}/{wc.sub}.{wc.side}.{WHITE}.sulci_labeled.gii"
    else:
        raise ValueError(f"Méthode inconnue : {wc.method}")
        
    return base_inputs  # Surtout pas de crochets [] autour de base_inputs !

rule compute_reproducibility_all_variants:
    input:
        unpack(get_method_inputs)   # <-- Ajout de unpack() ici
    output:
        tsv       = f"{OUT}/aggregated/{{sub}}/{{method}}/{{params_path}}/{{sub}}.{{side}}.reproducibility.tsv",
        alpha_tsv = f"{OUT}/aggregated/{{sub}}/{{method}}/{{params_path}}/{{sub}}.{{side}}.reproducibility_alpha.tsv",
    params:
        thr_basins = THR_BASINS,
        method     = lambda wc: wc.method,
        param      = lambda wc: wc.params_path,
    conda: ENVIRONMENTS["slam"]
    log: 
        f"{OUT}/aggregated/{{sub}}/{{method}}/{{params_path}}/{{sub}}.{{side}}.reproducibility.log"
    script:
        "scripts/repro_final.py"


def get_aggregation_inputs(wc):
    """Détermine tous les fichiers individuels à agréger pour une méthode donnée."""
    method = wc.method
    
    if method in ["zoe", "mindboggle", "trace"]:
        return expand(
            f"{OUT}/aggregated/{{sub}}/{method}/default/{{sub}}.{{side}}.reproducibility.tsv",
            sub=SUBJECTS,
            side=SIDE
        )
    # elif method == "zoe_adapt_dist":
    #     return expand(
    #         f"{OUT}/aggregated/{{sub}}/zoe_adapt_dist/{{seuil}}/{{sub}}.{{side}}.reproducibility.tsv",
    #         sub=SUBJECTS,
    #         side=SIDE,
    #         seuil=SEUILS_DIST
    #     )
    # elif method == "zoe_adapt_len":
    #     return expand(
    #         f"{OUT}/aggregated/{{sub}}/zoe_adapt_len/{{seuil}}/{{sub}}.{{side}}.reproducibility.tsv",
    #         sub=SUBJECTS,
    #         side=SIDE,
    #         seuil=SEUILS_LEN
    #     )
    # elif method == "zoe_adapt_both":
    #     return expand(
    #         f"{OUT}/aggregated/{{sub}}/zoe_adapt_both/d{{sdist}}_l{{slen}}/{{sub}}.{{side}}.reproducibility.tsv",
    #         sub=SUBJECTS,
    #         side=SIDE,
    #         sdist=SEUILS_DIST,
    #         slen=SEUILS_LEN
    #     )
    else:
        raise ValueError(f"Méthode d'agrégation inconnue : {method}")


rule aggregate_method_reproducibility:
    input:
        tsv_list = get_aggregation_inputs
    output:
        tsv       = f"{OUT}/aggregated/methods/{{method}}_all_reproducibility.tsv",
        alpha_tsv = f"{OUT}/aggregated/methods/{{method}}_all_reproducibility_alpha.tsv",
    conda: ENVIRONMENTS["slam"]
    log: 
        f"{OUT}/aggregated/methods/{{method}}_aggregation.log"
    script:
        "scripts/aggregate_reproducibility.py"


rule aggregate_standard_methods_together:
    input:
        tsv_list = expand(
            f"{OUT}/aggregated/methods/{{method}}_all_reproducibility.tsv",
            method=["trace", "mindboggle", "zoe"]
        )
    output:
        tsv       = f"{OUT}/aggregated/methods/trace_mindboggle_zoe_all_reproducibility.tsv",
        alpha_tsv = f"{OUT}/aggregated/methods/trace_mindboggle_zoe_all_reproducibility_alpha.tsv",
    conda: ENVIRONMENTS["slam"]
    log: 
        f"{OUT}/aggregated/methods/trace_mindboggle_zoe_aggregation.log"
    script:
        "scripts/aggregate_all_methods.py"


