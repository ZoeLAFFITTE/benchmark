#1. Filtering des bassins reproductibles ---------------------------------------
rule interpol_basins:
    input:
        basins_test_gii=f"{DATA}/{UP}/HCP_test/{{sub}}/{PITS}/{{sub}}.{SIDE}.{BASIN}.gii",
        basins_retest_gii=f"{DATA}/{UP}/HCP_retest/{{sub}}/{PITS}/{{sub}}.{SIDE}.{BASIN}.gii",
        sphere_reg_test_gii=f"{DATA}/{RAW}/HCP_test/{{sub}}/{REG}/{{sub}}.{SIDE}.{SPHEREREG}.surf.gii",
        sphere_reg_retest_gii=f"{DATA}/{RAW}/HCP_retest/{{sub}}/{REG}/{{sub}}.{SIDE}.{SPHEREREG}.surf.gii",
        sphere_template_gii=f"{ATLAS}.{SIDE}.{SPHERETEMP}.surf.gii"

    output:
        match_tsv=f"{OUT}/aggregated/{{sub}}/{{sub}}.{SIDE}.matching_tsv",
        basins_test_reg_gii=f"{OUT}/HCP_test/{{sub}}/postproc/{{sub}}.{SIDE}.{SPHERETEMP}.{BASIN}.gii",
        basins_retest_reg_gii=f"{OUT}/HCP_retest/{{sub}}/postproc/{{sub}}.{SIDE}.{SPHERETEMP}.{BASIN}.gii",
        filtered_basins_test_npy=f"{OUT}/HCP_test/{{sub}}/postproc/{{sub}}.{SIDE}.{SPHERETEMP}.{BASIN}.npy",
        filtered_basins_retest_npy=f"{OUT}/HCP_retest/{{sub}}/postproc/{{sub}}.{SIDE}.{SPHERETEMP}.{BASIN}.npy",

    conda: ENVIRONMENTS["slam"]

    log:
        f"{OUT}/aggregated/{{sub}}/{{sub}}.{SIDE}.interpol_basins.log"

    script:
        "scripts/compute_interpol.py"

#2. Reprojection des labels sur les sillons ------------------------------------
rule projected_labels:
    input:
        sphere_reg_gii=f"{DATA}/{RAW}/{{test}}/{{sub}}/{REG}/{{sub}}.{SIDE}.{SPHEREREG}.surf.gii",
        filtered_basins_npy=f"{OUT}/{{test}}/{{sub}}/postproc/{{sub}}.{SIDE}.{SPHERETEMP}.{BASIN}.npy",
        basins_gii=f"{DATA}/{UP}/{{test}}/{{sub}}/{PITS}/{{sub}}.{SIDE}.{BASIN}.gii",
        sulci_cachia=f"{OUT}/{{test}}/{{sub}}/cachia/{{sub}}.{SIDE}.{WHITE}.sulci.gii",
        sulci_mindboggle=f"{OUT}/{{test}}/{{sub}}/mindboggle/{{sub}}.{SIDE}.{WHITE}.fundi.gii",
        sulci_trace=f"{OUT}/{{test}}/{{sub}}/trace/{{sub}}.{SIDE}.{WHITE}.scurve_bary_c.gii"
    
    output:
        sulci_cachia_labeled=f"{OUT}/{{test}}/{{sub}}/cachia/{{sub}}.{SIDE}.{WHITE}.sulci.labeled.gii",
        sulci_mindboggle_labeled=f"{OUT}/{{test}}/{{sub}}/mindboggle/{{sub}}.{SIDE}.{WHITE}.fundi.labeled.gii",
        sulci_trace_labeled=f"{OUT}/{{test}}/{{sub}}/trace/{{sub}}.{SIDE}.{WHITE}.scurve_bary_c.labeled.gii"
    
    conda: ENVIRONMENTS["slam"]

    log:
        f"{OUT}/{{test}}/{{sub}}/postproc/{{sub}}.{SIDE}.projected_labels.log"

    script:
        "scripts/compute_overlap.py"

#3. hausdorff ------------------------------------------------------------------
rule hausdorff_dist:
    input:
        sphere_reg_gii_test=f"{DATA}/{RAW}/HCP_test/{{sub}}/{REG}/{{sub}}.{SIDE}.{SPHEREREG}.surf.gii",
        sulci_cachia_labeled_test=f"{OUT}/HCP_test/{{sub}}/cachia/{{sub}}.{SIDE}.{WHITE}.sulci.labeled.gii",
        sulci_mindboggle_labeled_test=f"{OUT}/HCP_test/{{sub}}/mindboggle/{{sub}}.{SIDE}.{WHITE}.fundi.labeled.gii",
        sulci_trace_labeled_test=f"{OUT}/HCP_test/{{sub}}/trace/{{sub}}.{SIDE}.{WHITE}.scurve_bary_c.labeled.gii",
        filtered_basins_npy_test=f"{OUT}/HCP_test/{{sub}}/postproc/{{sub}}.{SIDE}.{SPHERETEMP}.{BASIN}.npy",

        sphere_reg_gii_retest=f"{DATA}/{RAW}/HCP_retest/{{sub}}/{REG}/{{sub}}.{SIDE}.{SPHEREREG}.surf.gii",
        sulci_cachia_labeled_retest=f"{OUT}/HCP_retest/{{sub}}/cachia/{{sub}}.{SIDE}.{WHITE}.sulci.labeled.gii",
        sulci_mindboggle_labeled_retest=f"{OUT}/HCP_retest/{{sub}}/mindboggle/{{sub}}.{SIDE}.{WHITE}.fundi.labeled.gii",
        sulci_trace_labeled_retest=f"{OUT}/HCP_retest/{{sub}}/trace/{{sub}}.{SIDE}.{WHITE}.scurve_bary_c.labeled.gii",
        filtered_basins_npy_retest=f"{OUT}/HCP_retest/{{sub}}/postproc/{{sub}}.{SIDE}.{SPHERETEMP}.{BASIN}.npy",

    output:
        cachia_results_hausdorff_tsv = f"{OUT}/aggregated/{{sub}}/{{sub}}.{SIDE}.{SPHERETEMP}.cachia_hausdorff.tsv",
        cachia_results_mean_tsv = f"{OUT}/aggregated/{{sub}}/{{sub}}.{SIDE}.{SPHERETEMP}.cachia_mean.tsv",
        cachia_results_p95_tsv = f"{OUT}/aggregated/{{sub}}/{{sub}}.{SIDE}.{SPHERETEMP}.cachia_p95.tsv",

        trace_results_hausdorff_tsv = f"{OUT}/aggregated/{{sub}}/{{sub}}.{SIDE}.{SPHERETEMP}.trace_hausdorff.tsv",
        trace_results_mean_tsv = f"{OUT}/aggregated/{{sub}}/{{sub}}.{SIDE}.{SPHERETEMP}.trace_mean.tsv",
        trace_results_p95_tsv = f"{OUT}/aggregated/{{sub}}/{{sub}}.{SIDE}.{SPHERETEMP}.trace_p95.tsv",

        mindboggle_results_hausdorff_tsv = f"{OUT}/aggregated/{{sub}}/{{sub}}.{SIDE}.{SPHERETEMP}.mindboggle_hausdorff.tsv",
        mindboggle_results_mean_tsv = f"{OUT}/aggregated/{{sub}}/{{sub}}.{SIDE}.{SPHERETEMP}.mindboggle_mean.tsv",
        mindboggle_results_p95_tsv = f"{OUT}/aggregated/{{sub}}/{{sub}}.{SIDE}.{SPHERETEMP}.mindboggle_p95.tsv",
    
    conda: ENVIRONMENTS["slam"]

    log:
        f"{OUT}/aggregated/{{sub}}/{{sub}}.{SIDE}.hausdorff.log"

    script:
        "scripts/compute_hausdorff.py"

#4. aggrégation final ----------------------------------------------------------
rule aggregate_results:
    input:
        cachia_results_hausdorff_tsv = expand(
            f"{OUT}/aggregated/{{sub}}/{{sub}}.{SIDE}.{SPHERETEMP}.cachia_hausdorff.tsv",
            sub=SUBJECTS
        ),
        cachia_results_mean_tsv = expand(
            f"{OUT}/aggregated/{{sub}}/{{sub}}.{SIDE}.{SPHERETEMP}.cachia_mean.tsv",
            sub=SUBJECTS
        ),
        cachia_results_p95_tsv = expand(
            f"{OUT}/aggregated/{{sub}}/{{sub}}.{SIDE}.{SPHERETEMP}.cachia_p95.tsv",
            sub=SUBJECTS
        ),
        trace_results_hausdorff_tsv = expand(
            f"{OUT}/aggregated/{{sub}}/{{sub}}.{SIDE}.{SPHERETEMP}.trace_hausdorff.tsv",
            sub=SUBJECTS
        ),
        trace_results_mean_tsv = expand(
            f"{OUT}/aggregated/{{sub}}/{{sub}}.{SIDE}.{SPHERETEMP}.trace_mean.tsv",
            sub=SUBJECTS
        ),
        trace_results_p95_tsv = expand(
            f"{OUT}/aggregated/{{sub}}/{{sub}}.{SIDE}.{SPHERETEMP}.trace_p95.tsv",
            sub=SUBJECTS
        ),
        mindboggle_results_hausdorff_tsv = expand(
            f"{OUT}/aggregated/{{sub}}/{{sub}}.{SIDE}.{SPHERETEMP}.mindboggle_hausdorff.tsv",
            sub=SUBJECTS
        ),
        mindboggle_results_mean_tsv = expand(
            f"{OUT}/aggregated/{{sub}}/{{sub}}.{SIDE}.{SPHERETEMP}.mindboggle_mean.tsv",
            sub=SUBJECTS
        ),
        mindboggle_results_p95_tsv = expand(
            f"{OUT}/aggregated/{{sub}}/{{sub}}.{SIDE}.{SPHERETEMP}.mindboggle_p95.tsv",
            sub=SUBJECTS
        )

    output:
        cachia_hausdorff_tsv=f"{OUT}/aggregated/cachia_hausdorff.tsv",
        cachia_mean_tsv=f"{OUT}/aggregated/cachia_mean.tsv",
        cachia_p95_tsv=f"{OUT}/aggregated/cachia_p95.tsv",

        trace_hausdorff_tsv=f"{OUT}/aggregated/trace_hausdorff.tsv",
        trace_mean_tsv=f"{OUT}/aggregated/trace_mean.tsv",
        trace_p95_tsv=f"{OUT}/aggregated/trace_p95.tsv",

        mindboggle_hausdorff_tsv=f"{OUT}/aggregated/mindboggle_hausdorff.tsv",
        mindboggle_mean_tsv=f"{OUT}/aggregated/mindboggle_mean.tsv",
        mindboggle_p95_tsv=f"{OUT}/aggregated/mindboggle_p95.tsv"

    conda: ENVIRONMENTS["slam"]

    log:
        f"{OUT}/aggregated/aggregated.log"

    script:
        "scripts/aggregate_results.py"

#5. plots finaux ---------------------------------------------------------------
rule plots:
    input:
        cachia_hausdorff_tsv=f"{OUT}/aggregated/cachia_hausdorff.tsv",
        cachia_mean_tsv=f"{OUT}/aggregated/cachia_mean.tsv",
        cachia_p95_tsv=f"{OUT}/aggregated/cachia_p95.tsv",
        trace_hausdorff_tsv=f"{OUT}/aggregated/trace_hausdorff.tsv",
        trace_mean_tsv=f"{OUT}/aggregated/trace_mean.tsv",
        trace_p95_tsv=f"{OUT}/aggregated/trace_p95.tsv",
        mindboggle_hausdorff_tsv=f"{OUT}/aggregated/mindboggle_hausdorff.tsv",
