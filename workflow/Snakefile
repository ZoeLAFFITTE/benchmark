rule adapt:
    input:
        white_gii     = f"{DATA}/{RAW}/{{test}}/{{sub}}/{NATIVE}/{{sub}}.{{side}}.{WHITE}.surf.gii",
        dpf_white_gii = f"{OUT}/{{test}}/{{sub}}/preproc/{{sub}}.{{side}}.{WHITE}.DPF_star.gii",
        basins_gii    = f"{DATA_TEST}/{{test}}_{{sub}}_{{side}}_{BASIN}.gii",
    output:
        skeletons = f"{OUT}/{{test}}/{{sub}}/zoe/adapt/{{seuil}}/{{sub}}.{{side}}.{WHITE}.sulci.gii",
        borders   = f"{OUT}/{{test}}/{{sub}}/zoe/adapt/{{seuil}}/{{sub}}.{{side}}.{WHITE}.folds.gii",
        basins    = f"{OUT}/{{test}}/{{sub}}/zoe/adapt/{{seuil}}/{{sub}}.{{side}}.{WHITE}.gyri.gii",
        proba     = f"{OUT}/{{test}}/{{sub}}/zoe/adapt/{{seuil}}/{{sub}}.{{side}}.{WHITE}.paths.gii",
        fig       = f"{OUT}/{{test}}/{{sub}}/zoe/adapt/{{seuil}}/{{sub}}.{{side}}.{WHITE}.plot.html",
    params:
        seuil = lambda wc: int(wc.seuil),
    conda: ENVIRONMENTS["slam"]
    log: f"{OUT}/{{test}}/{{sub}}/zoe/adapt/{{seuil}}/{{sub}}.{{side}}.zoe-adapt.log"
    script:
        "scripts/zoe_algo.py"


rule projected_labels2:
    input:
        sphere_reg_gii      = f"{DATA}/{RAW}/{{test}}/{{sub}}/{REG}/{{sub}}.{{side}}.{SPHEREREG}.surf.gii",
        filtered_basins_npy = f"{OUT}/{{test}}/{{sub}}/postproc/{{sub}}.{{side}}.{SPHERETEMP}.{BASIN}.npy",
        basins_gii          = f"{DATA_TEST}/{{test}}_{{sub}}_{{side}}_{BASIN}.gii",
        sulci_zoe           = f"{OUT}/{{test}}/{{sub}}/zoe/adapt/{{seuil}}/{{sub}}.{{side}}.{WHITE}.sulci.gii",  # renommé
    output:
        sulci_zoe_labeled = f"{OUT}/{{test}}/{{sub}}/zoe/adapt/{{seuil}}/{{sub}}.{{side}}.{WHITE}.sulci_labeled.gii",
    params:
        seuil = lambda wc: int(wc.seuil),
    conda: ENVIRONMENTS["slam"]
    log: f"{OUT}/{{test}}/{{sub}}/zoe/adapt/{{seuil}}/{{sub}}.{{side}}.projected_labels.log"  # sans /postproc/
    script:
        "scripts/compute_labels.py"


rule hausdorff_dist2:
    input:
        match_tsv                = f"{OUT}/aggregated/{{sub}}/{{sub}}.{{side}}.matching.tsv",
        sphere_reg_gii_test      = f"{DATA}/{RAW}/HCP_test/{{sub}}/{REG}/{{sub}}.{{side}}.{SPHEREREG}.surf.gii",
        sulci_zoe_labeled_test   = f"{OUT}/HCP_test/{{sub}}/zoe/adapt/{{seuil}}/{{sub}}.{{side}}.{WHITE}.sulci_labeled.gii",
        sphere_reg_gii_retest    = f"{DATA}/{RAW}/HCP_retest/{{sub}}/{REG}/{{sub}}.{{side}}.{SPHEREREG}.surf.gii",
        sulci_zoe_labeled_retest = f"{OUT}/HCP_retest/{{sub}}/zoe/adapt/{{seuil}}/{{sub}}.{{side}}.{WHITE}.sulci_labeled.gii",
    output:
        zoe_results_tsv = f"{OUT}/aggregated/{{sub}}/zoe/adapt/{{seuil}}/{{sub}}.{{side}}.{SPHERETEMP}.zoe_dist.tsv",
