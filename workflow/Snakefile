    f"{DATA_TEST}/{{test}}_{{sub}}_{{side}}_basins_100.0_0.005_0.0.gii"
)
#SUBJECTS = sorted(set(SUBJECTS))

# Temporary restriction for development/testing.
TESTS = sorted(set(TESTS))[:2]
SUBJECTS = sorted(set(SUBJECTS))[:10]
SIDE = sorted(set(SIDE))[:2]

wildcard_constraints:
    seuil = r"\d+",
    test="HCP_test|HCP_retest",
    side="|".join(SIDE),
    sub=r"[^/_.]+",

OUT = "zoe_algo"
THR_BASINS = config["thr_basins"]
SEUILS = list(range(0, 26))  # 0 à 25 inclus


