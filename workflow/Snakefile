    input:
        L_white_mesh=f"{DATA}/{RAW}/{{test}}/{{sub}}/{NATIVE}/{{sub}}.L.{WHITE}.surf.gii",
        R_white_mesh=f"{DATA}/{RAW}/{{test}}/{{sub}}/{NATIVE}/{{sub}}.R.{WHITE}.surf.gii",
        L_trace_sulci=f"{OUT}/{{test}}/{{sub}}/trace/{{sub}}.L.{WHITE}.scurve_bary_c.labeled.gii",
        L_mindboggle_sulci=f"{OUT}/{{test}}/{{sub}}/mindboggle/{{sub}}.L.{WHITE}.fundi.labeled.gii",
        L_zoe_sulci=f"{OUT}/{{test}}/{{sub}}/zoe/{{sub}}.L.{WHITE}.sulci.labeled.gii",
        L_dpf_star=f"{OUT}/{{test}}/{{sub}}/preproc/{{sub}}.L.{WHITE}.DPF_star.gii",
        R_trace_sulci=f"{OUT}/{{test}}/{{sub}}/trace/{{sub}}.R.{WHITE}.scurve_bary_c.labeled.gii",
        R_mindboggle_sulci=f"{OUT}/{{test}}/{{sub}}/mindboggle/{{sub}}.R.{WHITE}.fundi.labeled.gii",
        R_zoe_sulci=f"{OUT}/{{test}}/{{sub}}/zoe/{{sub}}.R.{WHITE}.sulci.labeled.gii",
        R_dpf_star=f"{OUT}/{{test}}/{{sub}}/preproc/{{sub}}.R.{WHITE}.DPF_star.gii",
        L_filtered_basins=f"{OUT}/{{test}}/{{sub}}/postproc/{{sub}}.L.{SPHERETEMP}.{BASIN}.npy",
        R_filtered_basins=f"{OUT}/{{test}}/{{sub}}/postproc/{{sub}}.R.{SPHERETEMP}.{BASIN}.npy",

    output:
        fig=f"{OUT}/plots/{{test}}/{{sub}}/{{sub}}.both_hemi.sulci.html"

    conda:
        ENVIRONMENTS["slam"]

    log:
        f"{OUT}/plots/{{test}}/{{sub}}/{{sub}}.both_hemi.sulci.log"

    script:
        "scripts/all_proj.py"


