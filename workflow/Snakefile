# 0. Zoé_algo -----------------------------------------------------------------
rule zoe:
    input:
        white_gii = f"{DATA}/{RAW}/{{test}}/{{sub}}/{NATIVE}/{{sub}}.{{side}}.{WHITE}.surf.gii",
        dpf_white_gii = f"{OUT}/{{test}}/{{sub}}/preproc/{{sub}}.{{side}}.{WHITE}.DPF_star.gii",
        basins_gii =f"{DATA_TEST}/{{test}}_{{sub}}_{{side}}_{BASIN}.gii",

    output:
        skeletons = f"{OUT}/{{test}}/{{sub}}/zoe/{{sub}}.{{side}}.{WHITE}.sulci.gii",
        borders = f"{OUT}/{{test}}/{{sub}}/zoe/{{sub}}.{{side}}.{WHITE}.folds.gii",
        basins = f"{OUT}/{{test}}/{{sub}}/zoe/{{sub}}.{{side}}.{WHITE}.gyri.gii",
        proba = f"{OUT}/{{test}}/{{sub}}/zoe/{{sub}}.{{side}}.{WHITE}.paths.gii",
        fig = f"{OUT}/{{test}}/{{sub}}/zoe/{{sub}}.{{side}}.{WHITE}.plot.html",

    conda: ENVIRONMENTS["slam"]
    
    log: f"{OUT}/{{test}}/{{sub}}/zoe/{{sub}}.{{side}}.zoe.log"

    script:
        "scripts/zoe_algo.py"

# 1. Trace --------------------------------------------------------------------
rule trace:
    input:
        white_vtk=f"{OUT}/{{test}}/{{sub}}/preproc/{{sub}}.{{side}}.{WHITE}.vtk"
    output:
        sulci_curv=f"{OUT}/{{test}}/{{sub}}/trace/{{sub}}.{{side}}.{WHITE}.scurve",
        sulci_cart=f"{OUT}/{{test}}/{{sub}}/trace/{{sub}}.{{side}}.{WHITE}.scurve.cart",
        sulci_curv_bary=f"{OUT}/{{test}}/{{sub}}/trace/{{sub}}.{{side}}.{WHITE}.scurve.bary"
    log: f"{OUT}/{{test}}/{{sub}}/trace/{{sub}}.{{side}}.{WHITE}.trace.log"
    params:
        output_prefix=lambda wc: f"{OUT}/{wc.test}/{wc.sub}/trace/{wc.sub}.{wc.side}.{WHITE}"
    singularity: CONTAINERS["trace"]
    threads: 5
    shell:
        """
        time CurveExtraction \
            --inputSurface {input.white_vtk} \
            --outputCurve {params.output_prefix} \
            --nThreads {threads} \
            --sulcus --cart --bary --noVtk \
            2>&1 | tee {log}
        """


