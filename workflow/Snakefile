#1. Filtering des bassins reproductibles ---------------------------------------
rule overlap_basins:
    input:
        basins_test_gii=f"{DATA_TEST}/HCP_test_{{sub}}_{{side}}_{BASIN}.gii",
        basins_retest_gii=f"{DATA_TEST}/HCP_retest_{{sub}}_{{side}}_{BASIN}.gii",
        sphere_reg_test_gii=f"{DATA}/{RAW}/HCP_test/{{sub}}/{REG}/{{sub}}.{{side}}.{SPHEREREG}.surf.gii",
        sphere_reg_retest_gii=f"{DATA}/{RAW}/HCP_retest/{{sub}}/{REG}/{{sub}}.{{side}}.{SPHEREREG}.surf.gii",
        sphere_template_gii=f"{ATLAS}.{{side}}.{SPHERETEMP}.surf.gii",
        white_test_gii=f"{DATA}/{RAW}/HCP_test/{{sub}}/{NATIVE}/{{sub}}.{{side}}.{WHITE}.surf.gii",
        white_retest_gii=f"{DATA}/{RAW}/HCP_retest/{{sub}}/{NATIVE}/{{sub}}.{{side}}.{WHITE}.surf.gii",
    
    params:
        thr_basins=THR_BASINS,

    output:
        match_tsv=f"{OUT}/aggregated/{{sub}}/{{sub}}.{{side}}.matching.tsv",
        basins_test_reg_gii=f"{OUT}/HCP_test/{{sub}}/postproc/{{sub}}.{{side}}.{SPHERETEMP}.{BASIN}.gii",
        basins_retest_reg_gii=f"{OUT}/HCP_retest/{{sub}}/postproc/{{sub}}.{{side}}.{SPHERETEMP}.{BASIN}.gii",

    conda: ENVIRONMENTS["slam"]

    log:
        f"{OUT}/aggregated/{{sub}}/{{sub}}.{{side}}.overlap_basins.log"

    message :
        "postproc --> overlap_basins() (sub={wildcards.sub}, side={wildcards.side})"

    script:
        "scripts/compute_overlap.py"

#2. Reprojection des labels sur les sillons ------------------------------------
rule projected_labels:
    input:
        sphere_reg_gii=f"{DATA}/{RAW}/{{test}}/{{sub}}/{REG}/{{sub}}.{{side}}.{SPHEREREG}.surf.gii",
        basins_gii=f"{DATA_TEST}/{{test}}_{{sub}}_{{side}}_{BASIN}.gii",
        skeleton=f"{OUT}/{{test}}/{{sub}}/{{method_path}}/{{sub}}.{{side}}.skeletons.gii",

    output:
        skeletons_labeled=f"{OUT}/{{test}}/{{sub}}/{{method_path}}/{{sub}}.{{side}}.skeletons_labeled.gii",

    conda:
        ENVIRONMENTS["slam"]

    log:
        f"{OUT}/{{test}}/{{sub}}/postproc/{{method_path}}/{{sub}}.{{side}}.projected_labels.log"

    message:
        "postproc --> projected_labels() (method={wildcards.method_path}, sub={wildcards.sub}, side={wildcards.side}, test={wildcards.test})"

    script:
        "scripts/compute_labels.py"

#3. hausdorff ------------------------------------------------------------------
rule hausdorff_dist:
    input:
        match_tsv=f"{OUT}/aggregated/{{sub}}/{{sub}}.{{side}}.matching.tsv",
        sphere_reg_gii_test=f"{DATA}/{RAW}/HCP_test/{{sub}}/{REG}/{{sub}}.{{side}}.{SPHEREREG}.surf.gii",
        sphere_reg_gii_retest=f"{DATA}/{RAW}/HCP_retest/{{sub}}/{REG}/{{sub}}.{{side}}.{SPHEREREG}.surf.gii",
        skeletons_labeled_test=f"{OUT}/HCP_test/{{sub}}/{{method_path}}/{{sub}}.{{side}}.skeletons_labeled.gii",
        skeletons_labeled_retest=f"{OUT}/HCP_retest/{{sub}}/{{method_path}}/{{sub}}.{{side}}.skeletons_labeled.gii",

    params:
        thr_basins=THR_BASINS,

    output:
        results_tsv=f"{OUT}/aggregated/{{sub}}/{{method_path}}/{{sub}}.{{side}}.{SPHERETEMP}.hausdorff.tsv",

    conda: ENVIRONMENTS["slam"]

    log: f"{OUT}/aggregated/{{sub}}/{{method_path}}/{{sub}}.{{side}}.hausdorff_dist.log"

    message:
        "postproc --> hausdorff_dist() (method={wildcards.method_path}, sub={wildcards.sub}, side={wildcards.side})"

    script:
        "scripts/compute_hausdorff.py"

#4. plots ISBI ---------------------------------------------------------------------
rule plot_ISBI:
    input:
        match_tsv=f"{OUT}/aggregated/{{sub}}/{{sub}}.{{side}}.matching.tsv",
        white_gii=f"{DATA}/{RAW}/{{test}}/{{sub}}/{NATIVE}/{{sub}}.{{side}}.{WHITE}.surf.gii",
        dpf_white_gii=f"{OUT}/{{test}}/{{sub}}/preproc/{{sub}}.{{side}}.{WHITE}.DPF_star.gii",
        basins_white_gii=f"{DATA_TEST}/{{test}}_{{sub}}_{{side}}_{BASIN}.gii",
        skeletons_labeled=lambda wc: [
            f"{OUT}/{wc.test}/{wc.sub}/{mp}/{wc.sub}.{wc.side}.skeletons_labeled.gii"
            for mp in METHOD_PATHS
        ],

    params:
        thr_basins=THR_BASINS,
        method_names=METHOD_PATHS,

    output:
        dpf_plot=f"{OUT}/aggregated/{{sub}}/plots/{{test}}.{{side}}.dpf.html",
        boundary_plot=f"{OUT}/aggregated/{{sub}}/plots/{{test}}.{{side}}.boundary.html",
        skeletons_plot=f"{OUT}/aggregated/{{sub}}/plots/{{test}}/{{sub}}.{{side}}.skeletons.html",
        individual_plots=[
            f"{OUT}/aggregated/{{sub}}/{method_path}/plots/{{test}}/{{sub}}.{{side}}.skeletons.html"
            for method_path in METHOD_PATHS
        ],

    conda:
        ENVIRONMENTS["slam"]

    log:
        f"{OUT}/aggregated/{{sub}}/plots/{{test}}.{{side}}.plot_ISBI.log"

    message:
        "postproc --> plot_ISBI() (sub={wildcards.sub}, side={wildcards.side}, test={wildcards.test})"

    script:
        "scripts/plots_ISBI.py"

rule stats_desc:
    input:
        skeletons_labeled=f"{OUT}/{{test}}/{{sub}}/{{method_path}}/{{sub}}.{{side}}.skeletons_labeled.gii",
        white_gii=f"{DATA}/{RAW}/{{test}}/{{sub}}/{NATIVE}/{{sub}}.{{side}}.{WHITE}.surf.gii",
        basins_gii=f"{DATA_TEST}/{{test}}_{{sub}}_{{side}}_{BASIN}.gii",
        dpf_white_gii=f"{OUT}/{{test}}/{{sub}}/preproc/{{sub}}.{{side}}.{WHITE}.DPF_star.gii",

    output:
        results_tsv=f"{OUT}/aggregated/{{sub}}/{{method_path}}/{{test}}.{{sub}}.{{side}}.stats_desc.tsv",

    conda: ENVIRONMENTS["slam"]

    log: f"{OUT}/aggregated/{{sub}}/{{method_path}}/{{test}}.{{sub}}.{{side}}.stats_desc.log"

    message:
        "postproc --> stats_desc() (method={wildcards.method_path}, sub={wildcards.sub}, side={wildcards.side}, test={wildcards.test})"

    script:
        "scripts/compute_stats.py"


rule application:
    input:
        basins=lambda wc: [
            f"{DATA_TEST}/{test}_{sub}_{wc.side}_{BASIN}.gii"
            for test in TESTS
            for sub in SUBJECTS
        ],
        white_gii=lambda wc: [
            f"{DATA}/{RAW}/{test}/{sub}/{NATIVE}/{sub}.{wc.side}.{WHITE}.surf.gii"
            for test in TESTS
            for sub in SUBJECTS
        ],
        stats=lambda wc: [
            f"{OUT}/aggregated/{sub}/{wc.method_path}/{test}.{sub}.{wc.side}.stats_desc.tsv"
            for test in TESTS
            for sub in SUBJECTS
        ],
        sphere_reg_gii=lambda wc: [
            f"{DATA}/{RAW}/{test}/{sub}/{REG}/{sub}.{wc.side}.{SPHEREREG}.surf.gii"
            for test in TESTS
            for sub in SUBJECTS
        ],
        sphere_template_gii=lambda wc: f"{ATLAS}.{wc.side}.{SPHERETEMP}.surf.gii",
        white_template_gii=lambda wc: f"{ATLAS}.{wc.side}.{WHITETEMP}.surf.gii"

    conda:
        ENVIRONMENTS["slam"]

    output:
        individual_plots=[
            f"{OUT}/aggregated/{sub}/{{method_path}}/plots/{test}.{sub}.{{side}}.application.html"
            for test in TESTS
            for sub in SUBJECTS
        ],

        pop_plot=f"{OUT}/aggregated/{{method_path}}/plots/{{side}}.application.html"

    params:
        subjects=SUBJECTS,
        tests=TESTS

    log: f"{OUT}/aggregated/{{method_path}}/plots/{{side}}.application.log"

    message: "postproc --> application() (method={wildcards.method_path}, side={wildcards.side})"

    script:
        "scripts/application.py"


rule stats_repro:
    input:
        match_tsv=[
            f"{OUT}/aggregated/{sub}/{sub}.{side}.matching.tsv"
            for sub in SUBJECTS
            for side in SIDE
        ],

        hausdorff_tsv=[
            f"{OUT}/aggregated/{sub}/{method_path}/"
            f"{sub}.{side}.{SPHERETEMP}.hausdorff.tsv"
            for sub in SUBJECTS
            for side in SIDE
            for method_path in METHOD_PATHS
        ],

        desc_tsv=[
            f"{OUT}/aggregated/{sub}/{method_path}/"
            f"{test}.{sub}.{side}.stats_desc.tsv"
            for sub in SUBJECTS
            for side in SIDE
            for method_path in METHOD_PATHS
            for test in TESTS
        ],

    output:
        matching=f"{OUT}/aggregated/stats/matching.tsv",
        hausdorff=f"{OUT}/aggregated/stats/hausdorff.tsv",
        desc=f"{OUT}/aggregated/stats/descriptive.tsv",
        figure_bassin_pop_both=f"{OUT}/aggregated/stats/figure_bassin_pop_both.svg",
        figure_single=f"{OUT}/aggregated/stats/d.jpeg",
        figure_population=f"{OUT}/aggregated/stats/c.jpeg",
        tab=f"{OUT}/aggregated/stats/tableau_methodes.tex",
        friedman=f"{OUT}/aggregated/stats/test_friedman_comparaison_methodes.tsv",
        posthoc=f"{OUT}/aggregated/stats/tests_posthoc_wilcoxon_holm.tsv"

    singularity:
        CONTAINERS["r"]

    params:
        subjects=SUBJECTS,
        tests=TESTS,
        subject="130518",
        method_names=METHOD_PATHS

    log:
        f"{OUT}/aggregated/stats/stats_repro.log"

    message:
        "postproc --> stats_repro()"

    script:
        "scripts/stats.R"


