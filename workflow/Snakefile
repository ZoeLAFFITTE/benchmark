        seuil_len = lambda wc: float(wc.slen),

    conda: ENVIRONMENTS["slam"]
    
    log: f"{OUT}/{{test}}/{{sub}}/SFG/d{{sdist}}_l{{slen}}/{{sub}}.{{side}}.SFG.log"

    message :
        "fundi extraction --> SFG() (sub={wildcards.sub}, side={wildcards.side}, test={wildcards.test})"

    benchmark:
        f"{OUT}/{{test}}/{{sub}}/SFG/d{{sdist}}_l{{slen}}/{{sub}}.{{side}}.SFG.benchmark.txt"
    script:
        "scripts/zoe_algo.py"


