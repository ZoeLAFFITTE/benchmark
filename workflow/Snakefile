#1. VTIK -> GIFTII ------------------------------------------------------------
rule mindboggle_convert_gii:
    input:
        mesh=f"{DATA}/{RAW}/{{test}}/{{sub}}/{NATIVE}/{{sub}}.{{side}}.{WHITE}.surf.gii",
        curv_vtk=f"{OUT}/{{test}}/{{sub}}/mindboggle/{{sub}}.{{side}}.mean_curv.vtk",
        depth_vtk=f"{OUT}/{{test}}/{{sub}}/mindboggle/{{sub}}.{{side}}.depth.vtk",
        depth_rescaled_vtk=f"{OUT}/{{test}}/{{sub}}/mindboggle/{{sub}}.{{side}}.depth_rescaled.vtk",
        folds_vtk=f"{OUT}/{{test}}/{{sub}}/mindboggle/{{sub}}.{{side}}.folds.vtk",
        fundi_vtk=f"{OUT}/{{test}}/{{sub}}/mindboggle/{{sub}}.{{side}}.fundi.vtk",
    output:
        curv_gii=f"{OUT}/{{test}}/{{sub}}/mindboggle/{{sub}}.{{side}}.{WHITE}.mean_curv.gii",
        depth_gii=f"{OUT}/{{test}}/{{sub}}/mindboggle/{{sub}}.{{side}}.{WHITE}.depth.gii",
        depth_rescaled_gii=f"{OUT}/{{test}}/{{sub}}/mindboggle/{{sub}}.{{side}}.{WHITE}.depth_rescaled.gii",
        folds_gii=f"{OUT}/{{test}}/{{sub}}/mindboggle/{{sub}}.{{side}}.{WHITE}.folds.gii",
        fundi_gii=f"{OUT}/{{test}}/{{sub}}/mindboggle/{{sub}}.{{side}}.{WHITE}.fundi.gii"
    conda: ENVIRONMENTS["slam"]
    log: f"{OUT}/{{test}}/{{sub}}/mindboggle/{{sub}}.{{side}}.convert_vtk_gii.log"
    script:
        "scripts/mindboggle_convert_scalar_gii.py"

#2. Trace -> GIFTII ------------------------------------------------------------
rule trace_convert_scalar_gii:
    input:
        sulci_curv=f"{OUT}/{{test}}/{{sub}}/trace/{{sub}}.{{side}}.{WHITE}.scurve",
        sulci_curv_bary=f"{OUT}/{{test}}/{{sub}}/trace/{{sub}}.{{side}}.{WHITE}.scurve.bary",
        white_gii=f"{DATA}/{RAW}/{{test}}/{{sub}}/{NATIVE}/{{sub}}.{{side}}.{WHITE}.surf.gii"
    output:
        sulci_gii=f"{OUT}/{{test}}/{{sub}}/trace/{{sub}}.{{side}}.{WHITE}.scurve.gii",
        sulci_c_gii=f"{OUT}/{{test}}/{{sub}}/trace/{{sub}}.{{side}}.{WHITE}.scurve_c.gii",
        sulci_bary_gii=f"{OUT}/{{test}}/{{sub}}/trace/{{sub}}.{{side}}.{WHITE}.scurve_bary.gii",
        sulci_bary_c_gii=f"{OUT}/{{test}}/{{sub}}/trace/{{sub}}.{{side}}.{WHITE}.scurve_bary_c.gii",
    conda: ENVIRONMENTS["slam"]
    log: f"{OUT}/{{test}}/{{sub}}/trace/{{sub}}.{{side}}.{WHITE}.convert_scurve.log"
    script:
        "scripts/trace_convert_scalar_gii.py"


