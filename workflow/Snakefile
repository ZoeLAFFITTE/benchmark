#1. Filtering des bassins reproductibles ---------------------------------------
rule overlap_basins:
    input:
        basins_test_gii=f"{DATA_TEST}/HCP_test_{{sub}}_{{side}}_{BASIN}.gii",
        basins_retest_gii=f"{DATA_TEST}/HCP_retest_{{sub}}_{{side}}_{BASIN}.gii",
        sphere_reg_test_gii=f"{DATA}/{RAW}/HCP_test/{{sub}}/{REG}/{{sub}}.{{side}}.{SPHEREREG}.surf.gii",
        sphere_reg_retest_gii=f"{DATA}/{RAW}/HCP_retest/{{sub}}/{REG}/{{sub}}.{{side}}.{SPHEREREG}.surf.gii",
        sphere_template_gii=f"{ATLAS}.{{side}}.{SPHERETEMP}.surf.gii",
        white_test_gii=f"{DATA}/{RAW}/HCP_test/{{sub}}/{NATIVE}/{{sub}}.{{side}}.{WHITE}.surf.gii",
        white_retest_gii=f"{DATA}/{RAW}/HCP_retest/{{sub}}/{NATIVE}/{{sub}}.{{side}}.{WHITE}.surf.gii",
    
    params:
        thr_basins=THR_BASINS,


    output:
        match_tsv=f"{OUT}/aggregated/{{sub}}/{{sub}}.{{side}}.matching.tsv",
        basins_test_reg_gii=f"{OUT}/HCP_test/{{sub}}/postproc/{{sub}}.{{side}}.{SPHERETEMP}.{BASIN}.gii",
        basins_retest_reg_gii=f"{OUT}/HCP_retest/{{sub}}/postproc/{{sub}}.{{side}}.{SPHERETEMP}.{BASIN}.gii",
        filtered_basins_test_npy=f"{OUT}/HCP_test/{{sub}}/postproc/{{sub}}.{{side}}.{SPHERETEMP}.{BASIN}.npy",
        filtered_basins_retest_npy=f"{OUT}/HCP_retest/{{sub}}/postproc/{{sub}}.{{side}}.{SPHERETEMP}.{BASIN}.npy",
        basins_test_overlap_gii=f"{OUT}/HCP_test/{{sub}}/postproc/{{sub}}.{{side}}.{WHITE}.{BASIN}.overlap.gii",
        basins_retest_overlap_gii=f"{OUT}/HCP_retest/{{sub}}/postproc/{{sub}}.{{side}}.{WHITE}.{BASIN}.overlap.gii",
        proj_overlap_test=f"{OUT}/plots/{{sub}}/{{sub}}.{{side}}.proj_overlap_test.html",
        proj_overlap_retest=f"{OUT}/plots/{{sub}}/{{sub}}.{{side}}.proj_overlap_retest.html",
        hist=f"{OUT}/plots/{{sub}}/{{sub}}.{{side}}.hist_overlaps.html",

    conda: ENVIRONMENTS["slam"]

    log:
        f"{OUT}/aggregated/{{sub}}/{{sub}}.{{side}}.overlap_basins.log"

    script:
        "scripts/compute_overlap.py"


#2. Reprojection des labels sur les sillons ------------------------------------
rule projected_labels:
    input:
        sphere_reg_gii=f"{DATA}/{RAW}/{{test}}/{{sub}}/{REG}/{{sub}}.{{side}}.{SPHEREREG}.surf.gii",
        filtered_basins_npy=f"{OUT}/{{test}}/{{sub}}/postproc/{{sub}}.{{side}}.{SPHERETEMP}.{BASIN}.npy",
        basins_gii=f"{DATA_TEST}/{{test}}_{{sub}}_{{side}}_{BASIN}.gii",
        sulci_zoe=f"{OUT}/{{test}}/{{sub}}/zoe/{{sub}}.{{side}}.{WHITE}.sulci.gii",
        sulci_mindboggle=f"{OUT}/{{test}}/{{sub}}/mindboggle/{{sub}}.{{side}}.{WHITE}.fundi.gii",
        sulci_trace=f"{OUT}/{{test}}/{{sub}}/trace/{{sub}}.{{side}}.{WHITE}.scurve_bary_c.gii",
    output:
        sulci_zoe_labeled=f"{OUT}/{{test}}/{{sub}}/zoe/{{sub}}.{{side}}.{WHITE}.sulci.labeled.gii",
        sulci_mindboggle_labeled=f"{OUT}/{{test}}/{{sub}}/mindboggle/{{sub}}.{{side}}.{WHITE}.fundi.labeled.gii",
        sulci_trace_labeled=f"{OUT}/{{test}}/{{sub}}/trace/{{sub}}.{{side}}.{WHITE}.scurve_bary_c.labeled.gii",
    conda: ENVIRONMENTS["slam"]
    log: f"{OUT}/{{test}}/{{sub}}/postproc/{{sub}}.{{side}}.projected_labels.log"
    script:
        "scripts/compute_labels.py"

#3. hausdorff ------------------------------------------------------------------
rule hausdorff_dist:
    input:
        match_tsv=f"{OUT}/aggregated/{{sub}}/{{sub}}.{{side}}.matching.tsv",
        sphere_reg_gii_test=f"{DATA}/{RAW}/HCP_test/{{sub}}/{REG}/{{sub}}.{{side}}.{SPHEREREG}.surf.gii",
        sulci_zoe_labeled_test=f"{OUT}/HCP_test/{{sub}}/zoe/{{sub}}.{{side}}.{WHITE}.sulci.labeled.gii",
        sulci_mindboggle_labeled_test=f"{OUT}/HCP_test/{{sub}}/mindboggle/{{sub}}.{{side}}.{WHITE}.fundi.labeled.gii",
        sulci_trace_labeled_test=f"{OUT}/HCP_test/{{sub}}/trace/{{sub}}.{{side}}.{WHITE}.scurve_bary_c.labeled.gii",
        sphere_reg_gii_retest=f"{DATA}/{RAW}/HCP_retest/{{sub}}/{REG}/{{sub}}.{{side}}.{SPHEREREG}.surf.gii",
        sulci_zoe_labeled_retest=f"{OUT}/HCP_retest/{{sub}}/zoe/{{sub}}.{{side}}.{WHITE}.sulci.labeled.gii",
        sulci_mindboggle_labeled_retest=f"{OUT}/HCP_retest/{{sub}}/mindboggle/{{sub}}.{{side}}.{WHITE}.fundi.labeled.gii",
        sulci_trace_labeled_retest=f"{OUT}/HCP_retest/{{sub}}/trace/{{sub}}.{{side}}.{WHITE}.scurve_bary_c.labeled.gii",
    params:
        thr_basins=THR_BASINS,
    output:
        zoe_results_tsv=f"{OUT}/aggregated/{{sub}}/{{sub}}.{{side}}.{SPHERETEMP}.zoe_dist.tsv",
        trace_results_tsv=f"{OUT}/aggregated/{{sub}}/{{sub}}.{{side}}.{SPHERETEMP}.trace_dist.tsv",
        mindboggle_results_tsv=f"{OUT}/aggregated/{{sub}}/{{sub}}.{{side}}.{SPHERETEMP}.mindboggle_dist.tsv",
    conda: ENVIRONMENTS["slam"]
    log: f"{OUT}/aggregated/{{sub}}/{{sub}}.{{side}}.hausdorff.log"
    script:
        "scripts/compute_hausdorff.py"


#4. aggrégation final ----------------------------------------------------------
rule aggregate_results:
    input:
        zoe_results_tsv = expand(
            f"{OUT}/aggregated/{{sub}}/{{sub}}.{{side}}.{SPHERETEMP}.zoe_dist.tsv",
            sub=SUBJECTS, side=SIDE,
        ),
        trace_results_tsv = expand(
            f"{OUT}/aggregated/{{sub}}/{{sub}}.{{side}}.{SPHERETEMP}.trace_dist.tsv",
            sub=SUBJECTS, side=SIDE,
        ),
        mindboggle_results_tsv = expand(
            f"{OUT}/aggregated/{{sub}}/{{sub}}.{{side}}.{SPHERETEMP}.mindboggle_dist.tsv",
            sub=SUBJECTS, side=SIDE,
        ),
        # intermethod_results_tsv = expand(
        #     f"{OUT}/aggregated/{{sub}}/{{sub}}.{{side}}.{SPHERETEMP}.pairwise_dist.tsv",
        #     sub=SUBJECTS, side=SIDE,
        # ),

    output:
        all_methods_tsv=f"{OUT}/aggregated/all_dist.tsv",

    conda: ENVIRONMENTS["slam"]

    log:
        f"{OUT}/aggregated/aggregated.log"

    script:
        "scripts/aggregate_results.py"


rule aggregate_zoe_stats:
    input:
        expand(
            f"{OUT}/{{test}}/{{sub}}/zoe/{{sub}}.{{side}}.{WHITE}.stats.tsv",
            test=TESTS, sub=SUBJECTS, side=SIDE,
        ),
    output:
        f"{OUT}/aggregated/zoe_stats_complex.tsv",
    conda: ENVIRONMENTS["slam"]
    log: f"{OUT}/aggregated/zoe_stats_complex.log"
    script:
        "scripts/aggregate_zoe_stats.py"


